# Install inside Nginx's http configuration after replacing the domain,
# certificate locations and frontend build path. Not applied automatically.
server {
    listen 80;
    server_name fitness.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name fitness.example.com;
    ssl_certificate /etc/letsencrypt/live/fitness.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fitness.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/olympian/frontend/dist;
    index index.html;
    client_max_body_size 64k;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # This is the only trusted proxy hop. Overwrite client-supplied values.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }

    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
